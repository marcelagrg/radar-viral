# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ir para o GitHub (está no .gitignore).

# Endereço do banco. SQLite = um arquivo local. No futuro, PostgreSQL:
# DATABASE_URL=postgresql+psycopg://usuario:senha@localhost:5432/radar_viral
DATABASE_URL=sqlite:///data/radar_viral.db

# País padrão das coletas (código ISO 3166-1 alfa-2)
DEFAULT_COUNTRY=BR

# Similaridade mínima (0 a 1) para dois termos ficarem na mesma família de
# produtos (Etapa 4). Maior = famílias menores e mais "rígidas".
FAMILY_SIMILARITY_THRESHOLD=0.45

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
